# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# misc
.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local Web Push secrets
supabase/.env.push.local

supabase/.temp/

# Local audit command output (not application assets)
.audit-output/

# Rebuilt from trusted source by npm run build:marker before edge deployment
supabase/functions/_shared/server-marker.mjs
supabase/functions/_shared/server-marker.sha256

# Local POB semantic calibration evidence (do not commit provider outputs)
/pob-jan2026-calibration-results.json

# V2 worker bundle: built by tools/build-server-marker-v2.mjs, copied only during deploy
supabase/functions/_shared/server-marker-v2*
supabase/functions/mark-paper2-v2-shadow/server-marker-v2*.mjs
.v2-verify-runner.mjs
