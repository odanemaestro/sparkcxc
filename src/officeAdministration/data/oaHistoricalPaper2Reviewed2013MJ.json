      "layoutVerified": true
    },
    "OA-P2-2013-MJ::1::q1-c": {
      "prompt": "Vijay is employed as a clerical assistant in the Technical and Vocational Unit of the Ministry of Education. After six months, he is appraised by his supervisor as “someone with excellent interpersonal skills”. Outline TWO ways in which Vijay’s interpersonal skills can be used to settle disputes/conflicts at his workplace. (2 marks)",
      "promptVerified": true,
      "sourcePage": 2,
      "sourcePages": [
        2
      ],
      "layoutSourcePages": [
        2
      ],
      "layoutVerified": true
    },
    "OA-P2-2013-MJ::1::q1-d": {
      "prompt": "Ayana recently graduated from the School of Excellence with Grades I and II in eight CSEC subjects. She applies for a job as a teller at a local bank and is invited to attend an interview for the position. During the interview, she is asked the following questions:\n(i) Why did you apply for this job?\n(ii) What is your greatest strength?\n(iii) What are your career goals for the next five years For EACH of the questions listed above, write TWO appropriate responses that Ayana could give. (6 marks)",
      "promptVerified": true,
      "sourcePage": 2,
      "sourcePages": [
        2
      ],
      "layoutSourcePages": [
        2
      ],
      "layoutVerified": true
    },
