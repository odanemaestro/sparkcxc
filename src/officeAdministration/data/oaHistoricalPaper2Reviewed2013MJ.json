    },
    "OA-P2-2013-MJ::1::q1-b": {
      "prompt": "(i) Define the term ‘skill’ (2 marks)\n(ii) Word processing and time management are two important skills for office workers. State ONE reason why EACH of these skills is important to an organization. (2 marks)",
      "promptVerified": true,
      "sourcePage": 2,
