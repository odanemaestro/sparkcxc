# Copy this file to .env (or .env.local) and fill in your own values.
# .env / .env.local are already gitignored by Create React App's default
# .gitignore, so real credentials never get committed.
#
# Create React App only exposes variables prefixed with REACT_APP_ to the
# browser bundle, and only reads them at build/start time - restart
# `npm start` after changing this file.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
REACT_APP_SUPABASE_URL=

# Supabase anon/public API key (Project Settings -> API in the Supabase
# dashboard). This key is safe to expose in a browser bundle - it's the
# public key, not a service-role secret - but still shouldn't be committed
# to source control as a matter of hygiene.
REACT_APP_SUPABASE_ANON_KEY=
